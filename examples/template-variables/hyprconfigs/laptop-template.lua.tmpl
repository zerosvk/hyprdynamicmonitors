-- Laptop template using global template variables
{{- range .Monitors }}
{{- if eq .Tag "laptop" }}
hl.monitor({ output = "{{ .Name }}", mode = "1920x1080@{{ $.refresh_rate_ac }}", position = "0x0", scale = {{ $.default_scaling }} })
hl.config({ misc = { vrr = {{ $.default_vrr }} } })
{{- end }}
{{- end }}

-- Extra reserved area, merged into the eDP-1 rule above
hl.monitor({ output = "eDP-1", reserved_area = { top = 0, bottom = 0, left = 0, right = 0 } })

-- Using brightness variable
hl.on("hyprland.start", function()
    hl.exec_cmd("brightnessctl set {{ .brightness_high }}")
end)
